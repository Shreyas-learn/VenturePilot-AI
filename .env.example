# ==============================================================================
# VenturePilot AI — Environment Variables
#
# Instructions:
#   1. Duplicate this file and rename it .env
#        Windows:  copy .env.example .env
#        macOS/Linux: cp .env.example .env
#   2. Fill in YOUR values below — do not leave placeholders in .env
#   3. NEVER commit .env to version control (it is already in .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini Credentials  [REQUIRED]
# Only GEMINI_API_KEY is required. The application will not start without it.
# ------------------------------------------------------------------------------

# Your Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use for generation (default: gemini-3.8-flash)
# Recommended options:
#   gemini-3.8-flash          → latest, fast, cost-efficient (recommended)
#   gemini-2.0-flash          → previous generation
#   gemini-1.5-pro            → longer context window
#   gemini-1.5-flash          → lightweight, fast
# GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Gemini Generation Parameters  [OPTIONAL — safe defaults provided]
# ------------------------------------------------------------------------------

# Sampling temperature — lower = more deterministic, factual output (default: 0.2)
# For structured business reports 0.1–0.3 is recommended.
# GEMINI_TEMPERATURE=0.2

# Top-p nucleus sampling (default: 0.9)
# GEMINI_TOP_P=0.9

# Maximum output tokens per response (default: 8192)
# GEMINI_MAX_OUTPUT_TOKENS=8192

# ------------------------------------------------------------------------------
# RAG Pipeline Parameters  [OPTIONAL — safe defaults provided]
# ------------------------------------------------------------------------------

# Embedding provider: sentence-transformers (default; local, no API key required)
# PREFERRED_EMBEDDING_PROVIDER=sentence-transformers

# Characters per chunk when splitting PDF documents (default: 800)
# RAG_CHUNK_SIZE=800

# Character overlap between consecutive chunks (default: 150)
# RAG_CHUNK_OVERLAP=150

# Number of passages to retrieve per query (default: 5)
# RAG_TOP_K=5

# Cosine distance threshold — passages with distance > this are discarded (default: 0.8)
# Lower values = stricter relevance filtering.
# RAG_SIMILARITY_THRESHOLD=0.8

# Maximum characters of retrieved context injected into a single prompt (default: 3000)
# RAG_MAX_CONTEXT_CHARS=3000

# ------------------------------------------------------------------------------
# Application Settings  [OPTIONAL]
# ------------------------------------------------------------------------------

# Environment: development | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Storage Paths  [OPTIONAL — safe defaults provided]
# ------------------------------------------------------------------------------

# Directory containing categorized PDF knowledge documents (default: knowledge_base)
KNOWLEDGE_BASE_PATH=knowledge_base

# Directory where ChromaDB will persist its vector index (default: chroma_db)
CHROMA_DB_PATH=chroma_db

# Directory where generated PDF / Markdown reports are saved (default: exports)
EXPORTS_DIR=exports
